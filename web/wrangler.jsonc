{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "awesomeds",
  "compatibility_date": "2026-10-01",
  // main なし = アセットだけの Worker。スクリプト課金・10万/日の枠を使わない
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  // 空でもこのブロックが要る（wrangler preview）。assets と compatibility_date はトップレベル。routes は入れない。
  // Workers Builds の非本番コマンドは `pnpm exec wrangler versions upload` にする。
  // `wrangler preview` は assets-only でも no-op worker を付け、無いパスが 404 になる。
  // https://developers.cloudflare.com/workers/previews/configuration/#wrangler-configuration-file
  // https://developers.cloudflare.com/workers/ci-cd/builds/configuration/#preview-command
  "previews": {}
  // PR-B（切替）で追加:
  // "routes": [{ "pattern": "awesomeds.yumaker.studio/*", "zone_name": "yumaker.studio" }]
}
